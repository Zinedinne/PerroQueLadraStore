    },
    "Numero_Casa": {
      "type": "string"
    },
    "Estado_Pais": {
      "type": "string"
    },
    "Codigo_Postal": {
      "type": "string"
    },
    "Referencias": {
      "type": "text"
    },
    "MP_Payment_ID": {
      "type": "text"
    },
