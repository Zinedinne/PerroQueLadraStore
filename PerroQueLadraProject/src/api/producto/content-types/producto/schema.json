{
  "kind": "collectionType",
  "collectionName": "productos",
  "info": {
    "singularName": "producto",
    "pluralName": "productos",
    "displayName": "Producto"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "Nombre": {
      "type": "string"
    },
    "Marca": {
      "type": "string"
    },
    "Precio": {
      "type": "decimal"
    },
    "Imagen": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "Activo": {
      "type": "boolean"
    },
    "variantes": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::variantes-producto.variantes-producto"
    },
    "Descripcion": {
      "type": "text"
    },
    "carrito_productos": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::carrito-producto.carrito-producto",
      "mappedBy": "producto"
    },
    "tipo_producto": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::tipo-producto.tipo-producto"
    }
  }
}
