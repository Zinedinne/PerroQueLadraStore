{
  "kind": "collectionType",
  "collectionName": "eventos",
  "info": {
    "singularName": "evento",
    "pluralName": "eventos",
    "displayName": "Evento"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "Nombre": {
      "type": "string"
    },
    "FechaInicio": {
      "type": "date"
    },
    "Precio": {
      "type": "decimal"
    },
    "Media": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "Descripcion": {
      "type": "text",
      "required": true
    },
    "Ubicacion": {
      "type": "text"
    },
    "FolioMin": {
      "type": "integer"
    },
    "FolioMax": {
      "type": "integer"
    },
    "UrlInscripcion": {
      "type": "text"
    },
    "FechaFin": {
      "type": "datetime"
    }
  }
}
