{
  "kind": "collectionType",
  "collectionName": "eventos",
  "info": {
    "singularName": "evento",
    "pluralName": "eventos",
    "displayName": "Evento"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "Nombre": {
      "type": "string"
    },
    "FechaInicio": {
      "type": "date"
    },
    "Media": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "Descripcion": {
      "type": "text",
      "required": true
    },
    "Ubicacion": {
      "type": "text"
    },
    "FolioMin": {
      "type": "integer"
    },
    "FolioMax": {
      "type": "integer"
    },
    "UrlInscripcion": {
      "type": "text"
    },
    "FechaFin": {
      "type": "date"
    },
    "Horario": {
      "type": "time"
    },
    "DistanciasYCategoria": {
      "type": "text"
    },
    "KitsEntrega": {
      "type": "text"
    },
    "EstimulosYPremio": {
      "type": "text"
    },
    "InscripcionesYPrecio": {
      "type": "text"
    },
    "NotasImportantesYAdicionales": {
      "type": "text"
    },
    "evento_precios": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::evento-precio.evento-precio"
    },
    "boletos": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::boleto.boleto",
      "mappedBy": "evento"
    }
  }
}
